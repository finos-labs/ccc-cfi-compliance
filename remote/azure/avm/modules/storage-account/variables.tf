  description = <<-EOT
    Controls: CCC.Core.CN01 [coverage: full]
    Force HTTPS for storage requests.
  EOT
  type        = bool
  default     = true
}

variable "min_tls_version" {
  description = <<-EOT
    Controls: CCC.Core.CN01 [coverage: partial]
    Minimum TLS version (TLS1_0, TLS1_1, TLS1_2).
    Limitation: TLS1_2 is the highest the module/Azure exposes for storage; it is also the module default.
  EOT
  type        = string
  default     = "TLS1_2"
}

