  description = <<-EOT
    Controls: CCC.Core.CN05 [coverage: partial]
    Whether public network access is enabled.
    Limitation: Does NOT create private endpoints, private DNS zones, or VNet integration — configure var.private_endpoints (and DNS) on the AVM module for the account to remain reachable.
  EOT
  type        = bool
  default     = false
}

